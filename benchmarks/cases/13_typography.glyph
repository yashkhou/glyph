scene "Typography" @id("bench_typography") {
 canvas 1000 700 background "#FBFAF6";
 text kicker @id("kicker") { role "typography" "kicker"; content "GLYPH / 01"; x 120; y 130; size 22; font "SF Mono"; weight "600"; fill "#60716A"; }
 text h1 @id("headline") { role "typography" "headline"; content "Code for visual intent."; x 120; y 270; size 76; font "New York"; weight "700"; fill "#1E2925"; }
 text body @id("body") { role "typography" "body"; content "Semantic objects, relationships, constraints and deterministic rendering."; x 120; y 390; size 30; font "SF Pro"; weight "400"; max_width 760; line_height 40; fill "#4B5954"; }
 rect rule @id("rule") { role "typography" "rule"; x 120; y 470; width 760; height 8; rx 4; fill "#C8D3CD"; }
 constrain rule.center_x == canvas.center_x @required;
}
