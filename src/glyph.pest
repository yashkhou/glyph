WHITESPACE = _{ " " | "\t" | NEWLINE | COMMENT }
COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* }
file = { SOI ~ import_decl* ~ scene ~ EOI }
import_decl = { "import" ~ string ~ "as" ~ ident ~ ";" }
scene = { "scene" ~ string ~ scene_attr* ~ "{" ~ scene_item* ~ "}" }
scene_attr = _{ id_attr | version_attr }
version_attr = { "@version" ~ "(" ~ version_number ~ ")" }
scene_item = _{ canvas | metadata | style_def | paint_def | component_def | instance | repeat | animation | state_def | assertion | node | constraint }
canvas = { "canvas" ~ scalar ~ scalar ~ ("background" ~ string)? ~ ";" }
metadata = { "meta" ~ string ~ string ~ ";" }
style_def = { "style" ~ ident ~ "{" ~ prop* ~ "}" }
paint_def = { "paint" ~ ident ~ paint_kind ~ "{" ~ paint_item* ~ "}" }
paint_kind = { "linear" | "radial" }
paint_item = _{ paint_from | paint_to | paint_center | paint_radius | paint_stop }
paint_from = { "from" ~ scalar ~ scalar ~ ";" }
paint_to = { "to" ~ scalar ~ scalar ~ ";" }
paint_center = { "center" ~ scalar ~ scalar ~ ";" }
paint_radius = { "radius" ~ scalar ~ ";" }
paint_stop = { "stop" ~ scalar ~ string ~ ("opacity" ~ scalar)? ~ ";" }
component_def = { "component" ~ ident ~ "{" ~ component_item* ~ "}" }
component_item = _{ component_param | component_slot | component_variant | node }
component_param = { "param" ~ ident ~ ":" ~ type_name ~ "->" ~ prop_ref ~ binding_default? ~ ";" }
component_slot = { "slot" ~ ident ~ ":" ~ type_name ~ "->" ~ prop_ref ~ binding_default? ~ ";" }
binding_default = { "=" ~ prop_value }
component_variant = { "variant" ~ ident ~ "{" ~ variant_set* ~ "}" }
variant_set = { "set" ~ prop_ref ~ prop_value ~ ";" }
instance = { "instance" ~ ident ~ ident ~ id_attr? ~ "{" ~ instance_item* ~ "}" }
instance_item = _{ instance_param | instance_slot | instance_variant | instance_override | role | confidence | style_use | prop }
instance_param = { "param" ~ ident ~ prop_value ~ ";" }
instance_slot = { "slot" ~ ident ~ prop_value ~ ";" }
instance_variant = { "variant" ~ ident ~ ";" }
instance_override = { "override" ~ prop_ref ~ prop_value ~ ";" }
repeat = { "repeat" ~ ident ~ "count" ~ number ~ ("seed" ~ number)? ~ "{" ~ prop* ~ "}" }
animation = { "animate" ~ prop_ref ~ "from" ~ scalar ~ "to" ~ scalar ~ "duration" ~ scalar ~ ("easing" ~ string)? ~ ";" }
state_def = { "state" ~ ident ~ "{" ~ state_set* ~ "}" }
state_set = { "set" ~ prop_ref ~ prop_value ~ ";" }
assertion = { "assert" ~ prop_ref ~ relation ~ rhs ~ offset? ~ ";" }
node = { node_kind ~ ident ~ id_attr? ~ "{" ~ node_item* ~ "}" }
node_kind = { "rect" | "ellipse" | "path" | "text" | "image" | "group" }
node_item = _{ role | confidence | style_use | group_member | prop }
group_member = { "member" ~ ident ~ ";" }
style_use = { "use" ~ ident ~ ";" }
role = { "role" ~ string+ ~ ";" }
confidence = { "confidence" ~ "semantics" ~ maybe_number ~ "geometry" ~ maybe_number ~ "depth" ~ maybe_number ~ ";" }
maybe_number = { number | "unknown" }
prop = { ident ~ prop_value ~ ";" }
prop_value = _{ string | scalar | ident }
constraint = { "constrain" ~ prop_ref ~ relation ~ rhs ~ offset? ~ strength ~ ";" }
prop_ref = @{ ident ~ "." ~ ident }
rhs = { prop_ref | scalar }
offset = { sign ~ scalar }
sign = { "+" | "-" }
strength = { "@required" | "@strong" | "@medium" | "@weak" }
relation = { "==" | ">=" | "<=" }
id_attr = { "@id" ~ "(" ~ string ~ ")" }
type_name = @{ ASCII_ALPHA ~ (ASCII_ALPHANUMERIC | "_")* }
ident = @{ (ASCII_ALPHANUMERIC | "_" | "-" | "/" )+ }
scalar = _{ quantity | number }
quantity = @{ number ~ unit }
unit = { "px" | "deg" | "rad" | "%" | "ms" | "s" }
version_number = @{ ASCII_DIGIT+ }
number = @{ "-"? ~ ASCII_DIGIT+ ~ ("." ~ ASCII_DIGIT+)? }
string = @{ "\"" ~ ("\\\"" | !"\"" ~ ANY)* ~ "\"" }
